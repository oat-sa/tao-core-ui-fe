# AI Reasoning Maps config
# Paths are relative to project root (where .ai/ lives)

[traces]
# Extensions to scan for function parsing
extensions = .py, .js, .ts, .go, .rs, .java

# Ignore patterns (same semantics as gitignore)
ignore = tests/, node_modules/, __pycache__/, .venv/

[index]
# Backend: bm25 | chroma | none
backend = bm25

# Rebuild index on git hooks? (post-checkout, post-merge)
auto_rebuild = false

[search]
# Max results to display
limit = 10

# Include trace content in results (vs. just file:function references)
show_content = true
